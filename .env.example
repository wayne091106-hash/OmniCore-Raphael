# ══════════════════════════════════════════════════════════════
# OmniCore-Raphael 環境變數範本
# ── 複製成 .env 後填入自己的金鑰；切勿把含真實金鑰的 .env 上傳 ──
# ══════════════════════════════════════════════════════════════

# ── Gemini Live API ──────────────────────────────────────────
GEMINI_API_KEY=

# ── NIM (額外模型 Function Calling) ──────────────────────────
NIM_API_KEY=
NIM_MODEL=minimaxai/minimax-m2.7
MAX_TOOL_ROUNDS=8
OPENAI_API_KEY=

# ── Qdrant 記憶層 ───────────────────────────────────────────
# qdrant_local：使用 qdrant-client 本機持久化，不需另外啟 server
# qdrant_remote：連到外部 Qdrant server，使用下方 HOST/PORT
RAPHAEL_MEMORY_BACKEND=qdrant_local
QDRANT_PATH=tools/memory/qdrant_data
RAPHAEL_EMBEDDING_BACKEND=hashing
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
RAPHAEL_USER=wayne

# ── Raphael 語音設定 ─────────────────────────────────────────
RAPHAEL_VOICE=Puck
RAPHAEL_THINKING=

# ── 資料 API ────────────────────────────────────────────────
OPENWEATHER_API_KEY=
NEWS_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ── Google OAuth（憑證檔路徑，相對於專案根目錄）──────────────
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# ── 通訊推播 ────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_NOTIFY_TOKEN=
SLACK_WEBHOOK_URL=

# ── 開發者 ──────────────────────────────────────────────────
GITHUB_PAT=

# ── 外部接入 API（保留舊工具測試專案設定，正式 UI 目前不使用）────────
EXTERNAL_API_ENABLED=1
EXTERNAL_API_AUTH_CONFIRMED=1
EXTERNAL_API_TOKEN=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
